# ==============================================================================
# Patwatoli Textile ERP — Backend Production / Render Environment Example
# ==============================================================================
# Copy these values into your Render.com Web Service "Environment Variables" panel.
# DO NOT store real production secrets in this file.
# ==============================================================================

# Application Environment
APP_ENV=production
PORT=8080

# Render Managed PostgreSQL Connection String
# IMPORTANT: In production, always use `sslmode=require` for cloud PostgreSQL.
# Example: postgres://textile_user:secretpass@dpg-xxxx-a.singapore-postgres.render.com/textile_erp_prod?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_QmZoac8vkKF6@ep-round-haze-a1xcop3x-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional Redis Cache (Upstash Redis or Render Redis)
# Leave blank or omit if not using Redis; the ERP runs safely without Redis.
REDIS_URL=rediss://default:gQAAAAAAAbYgAAIgcDIzNmNlMjBhMzhiMDM0NDcxODlhMzZlNzM3ZjQyZGQ0Ng@full-fox-112160.upstash.io:6379

# Strong random secret key for JWT authentication (Minimum 32 characters)
JWT_SECRET=generate-a-strong-32-char-random-secret-key-for-production
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAY=7

# Vercel Production Frontend URL (Used for secure CORS headers)
# Example: https://patwatoli-erp.vercel.app
ALLOWED_ORIGIN=https://your-frontend-app.vercel.app
