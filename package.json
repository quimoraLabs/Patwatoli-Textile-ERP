{
  "name": "patwatoli-textile-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Patwatoli Textile ERP - Modular Monolith ERP System",
  "scripts": {
    "start": "cmd /c start.bat",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "backend:dev": "cd backend && go run ./cmd/api",
    "backend:test": "cd backend && go test -v ./...",
    "backend:seed": "cd backend && go run ./scripts/seed.go --admin",
    "backend:seed:demo": "cd backend && go run ./scripts/seed.go --demo",
    "seed": "cd backend && go run ./scripts/seed.go",
    "frontend:dev": "cd frontend && npm.cmd run dev",
    "frontend:build": "cd frontend && npm.cmd run build"
  }
}
