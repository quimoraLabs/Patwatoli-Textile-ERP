# ==============================================================================
# Patwatoli Textile ERP — Frontend Production / Vercel Environment Example
# ==============================================================================
# Set these variables in your Vercel Project Settings:
# Settings -> Environment Variables
# ==============================================================================

# Your live deployed Go Backend API URL on Render (with /api/v1 prefix)
# Example: https://patwatoli-textile-api.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://patwatoli-erp.onrender.com/api/v1

# Application branding name
NEXT_PUBLIC_APP_NAME=Patwatoli Textile ERP
