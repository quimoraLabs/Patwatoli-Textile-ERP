# ==========================================
# Patwatoli Textile ERP - Global .gitignore
# ==========================================

# 1. Environment & Secret Credentials
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
*.pem
*.key
*.cert

# Keep all example files tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Node.js & Next.js Frontend
node_modules/
*/node_modules/
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
.vercel/
*/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# 3. Go Backend Binaries & Artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
backend/bin/
backend/dist/
backend/api.exe
api.exe

# 4. Database Dumps & Backups
backups/
backend/backups/
*.sql.bak
*.sql.gz

# 5. OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# 6. Local Test / Temp Files
tmp/
temp/
coverage/
*/coverage/
coverage.txt
